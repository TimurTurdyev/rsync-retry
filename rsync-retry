#!/usr/bin/env bash
# rsync с повторами при обрыве связи: большие папки между серверами без присмотра.
set -u

STATE_DIR=${RSYNC_RETRY_HOME:-$HOME/.rsync-retry}

ATTEMPTS=10
DELAY=10
MAX_DELAY=300
TIMEOUT=120
NAME=
LOG=
BACKGROUND=0

RSYNC_PID=
STOPPED=0

usage() {
    cat <<'EOF'
Использование:
  rsync-retry [флаги] ИСТОЧНИК ЦЕЛЬ
  rsync-retry status [ИМЯ]
  rsync-retry stop ИМЯ

Флаги:
  -a, --attempts N      сколько раз пробовать, 0 - без ограничения (10)
  -d, --delay СЕК       пауза после первой неудачи, дальше растет вдвое (10)
  -m, --max-delay СЕК   предел паузы (300)
  -t, --timeout СЕК     обрыв, если данные не идут столько секунд (120)
  -n, --name ИМЯ        имя задачи для status и stop (по умолчанию папка источника)
  -b, --background      уйти в фон, вывод пишется в лог задачи
      --log ФАЙЛ        писать вывод в файл, а не на экран
  -h, --help            эта справка
EOF
}

die() {
    echo "rsync-retry: $*" >&2
    exit 64
}

log() {
    echo "[$(date '+%Y-%m-%d %H:%M:%S')] $*"
}

is_number() {
    case $1 in
        '' | *[!0-9]*) return 1 ;;
    esac
}

parse_args() {
    while [ $# -gt 0 ]; do
        case $1 in
            -a | --attempts) ATTEMPTS=${2:-}; shift ;;
            -d | --delay) DELAY=${2:-}; shift ;;
            -m | --max-delay) MAX_DELAY=${2:-}; shift ;;
            -t | --timeout) TIMEOUT=${2:-}; shift ;;
            -n | --name) NAME=${2:-}; shift ;;
            -b | --background) BACKGROUND=1 ;;
            --log) LOG=${2:-}; shift ;;
            -h | --help) usage; exit 0 ;;
            -*) die "неизвестный флаг $1, см. --help" ;;
            *)
                if [ -z "${SOURCE:-}" ]; then
                    SOURCE=$1
                elif [ -z "${TARGET:-}" ]; then
                    TARGET=$1
                else
                    die "лишний аргумент $1"
                fi
                ;;
        esac
        shift
    done

    [ -n "${SOURCE:-}" ] && [ -n "${TARGET:-}" ] || die "нужны ИСТОЧНИК и ЦЕЛЬ, см. --help"

    for value in "$ATTEMPTS" "$DELAY" "$MAX_DELAY" "$TIMEOUT"; do
        is_number "$value" || die "ожидалось целое число, а не '$value'"
    done

    if [ -z "$NAME" ]; then
        NAME=$(basename "${SOURCE%/}")
    fi

    NAME=$(printf '%s' "$NAME" | tr -c 'A-Za-z0-9._-' '_')

    if [ -z "$LOG" ] && [ "$BACKGROUND" = 1 ]; then
        LOG=$STATE_DIR/$NAME.log
    fi
}

# Коды rsync, после которых есть смысл пробовать снова: сеть, ssh, таймауты.
# Остальное (синтаксис, права, место на диске) повтором не лечится.
is_retryable() {
    case $1 in
        5 | 10 | 12 | 30 | 35 | 255) return 0 ;;
        *) return 1 ;;
    esac
}

# Каталог-замок создается атомарно. Если владелец умер, замок снимается.
lock() {
    mkdir -p "$STATE_DIR"

    if mkdir "$STATE_DIR/$NAME.lock" 2>/dev/null; then
        echo $$ > "$STATE_DIR/$NAME.pid"
        return 0
    fi

    local pid
    pid=$(cat "$STATE_DIR/$NAME.pid" 2>/dev/null)

    if [ -n "$pid" ] && kill -0 "$pid" 2>/dev/null; then
        die "задача $NAME уже идет (pid $pid), см. rsync-retry status $NAME"
    fi

    rm -rf "$STATE_DIR/$NAME.lock" "$STATE_DIR/$NAME.pid"
    mkdir "$STATE_DIR/$NAME.lock" 2>/dev/null || die "не удалось занять задачу $NAME"
    echo $$ > "$STATE_DIR/$NAME.pid"
}

unlock() {
    rm -rf "$STATE_DIR/$NAME.lock" "$STATE_DIR/$NAME.pid"
}

on_signal() {
    STOPPED=1

    if [ -n "$RSYNC_PID" ]; then
        kill -TERM "$RSYNC_PID" 2>/dev/null
    fi
}

run() {
    local attempt=1 delay=$DELAY code started
    started=$(date +%s)

    if [ -n "$LOG" ]; then
        mkdir -p "$(dirname "$LOG")"
        exec >> "$LOG" 2>&1
    fi

    lock
    trap unlock EXIT
    trap on_signal INT TERM

    log "старт: $SOURCE -> $TARGET"

    while true; do
        if [ "$ATTEMPTS" = 0 ]; then
            log "попытка $attempt"
        else
            log "попытка $attempt из $ATTEMPTS"
        fi

        rsync -ah --partial --stats --timeout="$TIMEOUT" "$SOURCE" "$TARGET" &

        RSYNC_PID=$!
        wait "$RSYNC_PID"
        code=$?

        if [ "$STOPPED" = 1 ]; then
            wait "$RSYNC_PID" 2>/dev/null
            log "остановлено на попытке $attempt"
            exit 143
        fi

        RSYNC_PID=

        # 24 - часть файлов исчезла во время передачи, остальное доехало.
        if [ "$code" = 0 ] || [ "$code" = 24 ]; then
            log "готово за $(( $(date +%s) - started )) сек, попыток: $attempt"
            exit 0
        fi

        if ! is_retryable "$code"; then
            log "ошибка rsync $code, повтор не поможет"
            exit "$code"
        fi

        if [ "$ATTEMPTS" != 0 ] && [ "$attempt" -ge "$ATTEMPTS" ]; then
            log "ошибка rsync $code, попытки кончились"
            exit "$code"
        fi

        log "ошибка rsync $code, повтор через $delay сек"
        sleep "$delay" &
        RSYNC_PID=$!
        wait "$RSYNC_PID"
        RSYNC_PID=

        if [ "$STOPPED" = 1 ]; then
            log "остановлено во время паузы"
            exit 143
        fi

        delay=$(( delay * 2 > MAX_DELAY ? MAX_DELAY : delay * 2 ))
        attempt=$(( attempt + 1 ))
    done
}

# Фоновый запуск: тот же скрипт под nohup, флаг -b уже не нужен.
background() {
    local args=() arg pid

    for arg in "$@"; do
        [ "$arg" = -b ] || [ "$arg" = --background ] || args+=("$arg")
    done

    pid=$(cat "$STATE_DIR/$NAME.pid" 2>/dev/null)

    if [ -n "$pid" ] && kill -0 "$pid" 2>/dev/null; then
        die "задача $NAME уже идет (pid $pid), см. rsync-retry status $NAME"
    fi

    mkdir -p "$STATE_DIR"
    nohup "$0" --log "$LOG" "${args[@]}" > /dev/null 2>&1 &

    echo "задача $NAME запущена в фоне, pid $!"
    echo "лог: $LOG"
    echo "ход: rsync-retry status $NAME, остановить: rsync-retry stop $NAME"
}

status() {
    local name=${1:-} pid file

    if [ -z "$name" ]; then
        for file in "$STATE_DIR"/*.pid; do
            [ -e "$file" ] || { echo "нет запущенных задач"; return 0; }
            name=$(basename "$file" .pid)
            pid=$(cat "$file")
            echo "$name: pid $pid"
        done

        return 0
    fi

    pid=$(cat "$STATE_DIR/$name.pid" 2>/dev/null)

    if [ -n "$pid" ] && kill -0 "$pid" 2>/dev/null; then
        echo "$name: идет, pid $pid"
    else
        echo "$name: не запущена"
    fi

    if [ -f "$STATE_DIR/$name.log" ]; then
        grep '^\[' "$STATE_DIR/$name.log" | tail -n 5
    fi
}

stop() {
    local name=${1:-} pid waited=0

    [ -n "$name" ] || die "укажите имя задачи, список: rsync-retry status"

    pid=$(cat "$STATE_DIR/$name.pid" 2>/dev/null)

    if [ -z "$pid" ] || ! kill -0 "$pid" 2>/dev/null; then
        echo "$name: не запущена"
        return 0
    fi

    kill -TERM "$pid"

    while [ "$waited" -lt 10 ]; do
        kill -0 "$pid" 2>/dev/null || { echo "$name: остановлена"; return 0; }
        sleep 1
        waited=$(( waited + 1 ))
    done

    die "$name не остановилась за 10 сек, pid $pid"
}

case ${1:-} in
    status) shift; status "$@" ;;
    stop) shift; stop "$@" ;;
    '') usage; exit 64 ;;
    *)
        parse_args "$@"

        if [ "$BACKGROUND" = 1 ]; then
            background "$@"
        else
            run
        fi
        ;;
esac
